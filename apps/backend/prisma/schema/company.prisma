model Company {
  id           String  @id @default(cuid())
  businessName String // nombre que aparece en las facturas (razón social de la empresa)
  tradeName    String? // es el nombre comercial
  taxId        String? @unique    // Tax identification number (e.g. CUIT, NIF, VAT, EIN)
  email        String?
  phone        String?
  address      String?
  city         String?
  state        String?
  country      String      // ISO 3166-1 alpha-2 country code (e.g. AR, ES, US)
  postalCode   String?
  logoUrl      String?
  currency     String  @default("ARS") // ISO 4217 currency code (e.g. ARS, USD, EUR)
  timezone     String  @default("America/Argentina/Buenos_Aires")   // IANA time zone (e.g. America/Argentina/Buenos_Aires, Europe/Madrid)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  roles     Role[]
  customers Customer[]
  taxes Tax[]
}
