model Tax {
  id        String   @id @default(cuid())
  companyId String
  name      String // Tax name (e.g. IVA 21%, VAT, Sales Tax)
  rate      Decimal  @db.Decimal(5, 2) // Tax rate percentage (e.g. 21.00, 10.50, 8.25)
  isDefault Boolean  @default(false) // Indicates whether this is the default tax for the company.
  isActive  Boolean  @default(true) // Indicates whether the tax is active.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}
